# Copy to .env and fill in values
KARTVERKET_BASE_URL=https://ws.geonorge.no
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Claude-backed AI analysis. Without a key, the app uses rule-based fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Override either agent separately if needed.
ANTHROPIC_ARCHITECT_MODEL=
ANTHROPIC_ENGINEER_MODEL=
