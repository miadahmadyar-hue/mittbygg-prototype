# Copy to .env and fill in values
KARTVERKET_BASE_URL=https://ws.geonorge.no
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI document reviews. Without a key, AI reports that it is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Override either agent separately if needed.
OPENAI_ARCHITECT_MODEL=
OPENAI_ENGINEER_MODEL=
