# Auto-detect text files; normalize line endings.
* text=auto

# Treat these as binary — never run line-ending conversion.
*.pdf  binary
*.xlsx binary
*.xls  binary
*.docx binary
*.doc  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.dxf  binary
*.ifc  binary

# Source files: enforce LF on commit (cross-platform-friendly).
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
